    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "CUDA_VISIBLE_DEVICES": "3"
            }
        },
        {
            "name": "Single image optimization",
            "type": "debugpy",
            "request": "launch",
            "module": "locmark.main",       // running module
            "cwd": "${workspaceFolder}",    // fixed working directory
            "console": "integratedTerminal",
            "env": {
                "CUDA_VISIBLE_DEVICES": "3"
            }
        },
                {
            "name": "Eval AGE",
            "type": "debugpy",
            "request": "launch",
            "module": "eval_AGE",       // running module
            "cwd": "${workspaceFolder}",    // fixed working directory
            "console": "integratedTerminal",
            "env": {
                "CUDA_VISIBLE_DEVICES": "2"
            },
            "args": [
                "target_model=omniguard",
                "save_path=/mnt/nas5/suhyeon/projects/eval_spliceless/omniguard/all_512_eval_256",
                "tamper_mode=zero_mask"
            ]
        }
    ]
}
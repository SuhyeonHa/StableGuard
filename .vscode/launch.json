{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Accelerate: train.py",
            "type": "python",
            "request": "launch",
            "module": "accelerate.commands.launch",
            "console": "integratedTerminal",
            "env": {
                // "CUDA_VISIBLE_DEVICES": "2,3"
                "CUDA_VISIBLE_DEVICES": "3"
            },
            "args": [
                "--num_processes",
                "1",
                "--main_process_port",
                "58111",
                // "--multi-gpu",
                // "--mixed_precision",
                // "no",
                "train.py",
                "--pretrained_model_name_or_path=stabilityai/stable-diffusion-2-1-base",
                "--data_root_path=/mnt/nas5/suhyeon/datasets/coco-2017",
                "--mask_pool_path=/mnt/nas5/suhyeon/datasets/coco-tamper-stableguard/datasets/mask_pool",
                "--resolution=256",
                "--train_batch_size=3",
                "--dataloader_num_workers=4",
                "--learning_rate=1e-4",
                "--weight_decay=1e-2",
                "--output_dir=/mnt/nas5/suhyeon/projects/freqloc-ldm/test",
                "--cache_dir=/mnt/nas5/suhyeon/caches",
                "--save_steps=10000",
                "--num_train_epochs=10",
                "--noise_strength",
                "0.0",
                "0.5",
                "--num_bits=3"
            ]
        }
    ]
}